  currency        String   @default("INR")
  status          String   @default("CREATED") // CREATED, PAID, FAILED, REFUNDED
  gateway         String   @default("RAZORPAY") // RAZORPAY, STRIPE, MANUAL
  signature       String?  // payment signature for verification
  receiptNo       String?  // internal receipt number
  invoiceNo       String?  // generated invoice number
  description     String?
  createdAt       DateTime @default(now())
  paidAt          DateTime?
  verifiedAt      DateTime?
  rawResponse     String?  // JSON of the full gateway response
  createdAt2      DateTime @default(now()) // alias for queries

  @@index([schoolId, status, createdAt])
  @@index([studentId])
  @@index([orderId])
}

// ============ PUSH NOTIFICATION SUBSCRIPTIONS ============
model PushSubscription {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  userId          String   // FK to User
  endpoint        String   @unique // FCM device token or web push endpoint
