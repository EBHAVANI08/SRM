// ============ SAFETY ALERTS (extended for Safety module v2) ============
model SafetyAlert {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  type            String   // VIOLENCE, WEAPON, FALL_MEDICAL, INTRUSION, SMOKE_FIRE, CROWD_DENSITY, PROLONGED_ABSENCE, UNKNOWN_FACE, DRILL
  severity        String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  location        String
  description     String
  cameraId        String?
  camera          SafetyCamera? @relation(fields: [cameraId], references: [id])
  zoneId          String?
  zone            SafetyZone?   @relation(fields: [zoneId], references: [id])
  studentId       String?
  student         Student? @relation("StudentSafetyAlerts", fields: [studentId], references: [id])
  staffId         String?
  status          String   @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, RESOLVED, FALSE_ALARM
  aiConfidence    Float?
  detectionSource String   @default("MANUAL") // VLM, RULE, MANUAL, DRILL
  snapshotUrl     String?
  clipUrl         String?
  reviewedBy      String?
  reviewedAt      DateTime?
  escalationLevel Int      @default(0)
  auditChainHash  String?
  triggeredAt     DateTime @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?
  actionTaken     String?
  createdAt       DateTime @default(now())

  @@index([schoolId, status, triggeredAt])
  @@index([schoolId, severity, triggeredAt])
  @@index([cameraId, triggeredAt])
  @@index([zoneId, triggeredAt])
}

// ============ SAFETY — ZONES ============
model SafetyZone {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  name            String   // "Building A", "Playground", "Parking Lot"
  parentZoneId    String?
  parent          SafetyZone?   @relation("ZoneTree", fields: [parentZoneId], references: [id])
  children        SafetyZone[]  @relation("ZoneTree")
  linkedClassId   String?
  linkedClass     Class?        @relation("ClassSafetyZone", fields: [linkedClassId], references: [id])
  riskLevel       String   @default("low") // low, moderate, high, critical
  floorPlan       String?  // optional SVG/PNG of the floor plan
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cameras         SafetyCamera[]
  alerts          SafetyAlert[]

  @@index([schoolId])
  @@index([parentZoneId])
}

// ============ SAFETY — CAMERAS ============
model SafetyCamera {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  zoneId          String?
  zone            SafetyZone?   @relation(fields: [zoneId], references: [id])
  name            String
  location        String   // free-text: "Block A — 1st Floor Corridor"
  protocol        String   @default("RTSP") // RTSP, ONVIF, HTTP_MJPEG
  streamUrl       String   // stored ENCRYPTED at app layer (AES-256-GCM via safety/crypto.ts)
  credentialsEnc  String?  // encrypted JSON: {user,pass} — never plaintext, never sent to client
  relayUrl        String?  // on-prem relay webhook URL (architecture decision A+C)
  status          String   @default("OFFLINE") // ONLINE, OFFLINE, ERROR, DEGRADED
  lastCheckedAt   DateTime?
  lastSnapshotUrl String?  // path to most recent test frame (under /public/safety-snapshots/)
  lastLatencyMs   Int?
  lastResolution  String?
  lastCodec       String?
  hasMic          Boolean  @default(false)
  hasSpeaker      Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  detectionConfigs SafetyDetectionConfig[]
  alerts           SafetyAlert[]

  @@index([schoolId, status])
  @@index([zoneId])
}

// ============ SAFETY — DETECTION CONFIG (per camera × detection type) ============
model SafetyDetectionConfig {
  id              String   @id @default(cuid())
  cameraId        String
  camera          SafetyCamera @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  detectionType   String   // VIOLENCE, WEAPON, FALL_MEDICAL, INTRUSION, SMOKE_FIRE, CROWD_DENSITY, PROLONGED_ABSENCE
  enabled         Boolean  @default(true)
  sensitivity     String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  cooldownSec     Int      @default(60) // min seconds between same-type alerts from same camera
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([cameraId, detectionType])
  @@index([cameraId])
}

// ============ SAFETY — TAMPER-EVIDENT AUDIT LOG (hash-chained) ============
model SafetyAuditLog {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  entryHash       String   // SHA-256(own content + prevHash)
  prevHash        String   // previous entry's entryHash — chain linkage
  actorId         String?
  actorRole       String?
  action          String   // CAMERA_CREATE, CAMERA_UPDATE, CAMERA_DELETE, CONNECTION_TEST, ALERT_REVIEW, ALERT_ESCALATE, NOTIFICATION_DISPATCH, DRILL_TRIGGER, CONFIG_CHANGE, CHAIN_VERIFY, BEHAVIOR_SEND, VISITOR_CHECKIN
  targetType      String   // CAMERA, ALERT, ZONE, RULE, DRILL, SYSTEM, BEHAVIOR, VISITOR
  targetId        String?
  payload         String   // JSON string of full action context
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

// ============ SAFETY — ESCALATION RULES (per school × severity) ============
model SafetyEscalationRule {
  id                  String   @id @default(cuid())
  schoolId            String   @default("school_default")
  severity            String   // LOW, MEDIUM, HIGH, CRITICAL
  notifyRoles         String   // JSON array: ["SUPER_ADMIN","SCHOOL_HEAD","IT_TEAM"]
  notifyChannels      String   @default("[\"WHATSAPP\",\"SMS\",\"IN_APP\"]") // JSON array
  escalateAfterMin    Int      @default(15)
  escalateToRoles     String?  // JSON array for next tier
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([schoolId, severity])
  @@index([schoolId])
}

// ============ SAFETY — VISITOR MANAGEMENT ============
model SafetyVisitor {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  name            String
  phone           String?
  email           String?
  purpose         String
  hostStaffId     String?  // FK to Staff.id (no DB FK to keep loose coupling across modules)
  hostName        String?
  expectedAt      DateTime?
  checkInAt       DateTime?
  checkOutAt      DateTime?
  status          String   @default("PRE_APPROVED") // PRE_APPROVED, CHECKED_IN, CHECKED_OUT, DENIED, UNKNOWN_FLAGGED
  faceEncRef      String?  // reference to enrolled face embedding
  photoUrl        String?
  isUnknown       Boolean  @default(false) // true if face didn't match any enrolled person
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, status])
  @@index([expectedAt])
}

// ============ SAFETY — BEHAVIOR REPORTS ============
model SafetyBehaviorReport {
  id                  String   @id @default(cuid())
  schoolId            String   @default("school_default")
  subjectType         String   // STUDENT, STAFF
  subjectId           String   // FK to Student.id or Staff.id (no DB FK to keep loose coupling)
  subjectName         String
  reportingPeriod     String   // 2026-W27, 2026-07, 2026-Q3
  score               Int      // 0-100
  trendDelta          Int      // change vs previous period (+/-)
  summary             String
  topIncidents        String   // JSON array of {date, type, location}
  recommendedActions  String
  sentToGuardian      Boolean  @default(false)
  sentAt              DateTime?
  commId              String?  // FK to CommunicationLog.id
  generatedBy         String?
  createdAt           DateTime @default(now())

  @@index([schoolId, subjectType, subjectId])
  @@index([reportingPeriod])
}

// ============ SAFETY — DRILLS ============
model SafetyDrill {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  type            String   // LOCKDOWN, FIRE, EARTHQUAKE
  triggeredBy     String   // userId
  triggeredAt     DateTime @default(now())
  endedAt         DateTime?
  durationSec     Int?
  camerasActivated Int     @default(0)
  notificationsSent Int    @default(0)
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  notes           String?

  @@index([schoolId, triggeredAt])
}

// ============ SAFETY — SCHEDULED ATTENDANCE (auto-run per period) ============
model SafetyScheduledAttendance {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  classId         String   // FK to Class (no DB FK to avoid coupling; classId is enough)
  className       String
  cameraId        String   // FK to SafetyCamera
  period          Int      // 1-8
  scheduledAt     DateTime // when to auto-run
  lastRunAt       DateTime?
  lastResult      String?  // JSON: {present:[], absent:[], unknown:[]}
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([classId, period])
  @@index([schoolId, scheduledAt])
}

// ============ GOOGLE SHEET SYNC (Attendance Reports) ============
model GoogleSheetSyncConfig {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  spreadsheetId   String   // Google Sheets spreadsheet ID
  sheetName       String   @default("Daily Attendance") // tab name
  serviceAccountEmail String? // for service-account auth
  privateKeyEnc   String?  // encrypted service account private key
  apiKey          String?  // alternative: simple API key auth
  syncTime        String   @default("18:00") // HH:MM — daily sync time
  isActive        Boolean  @default(true)
  lastSyncAt      DateTime?
  lastSyncStatus  String?  // SUCCESS, FAILED, PARTIAL
  lastSyncError   String?
  lastSyncRows    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, isActive])
}

model GoogleSheetSyncLog {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  configId        String
  date            String   // YYYY-MM-DD — the attendance date synced
  rowsSynced      Int
  status          String   // SUCCESS, FAILED, PARTIAL
  error           String?
  spreadsheetUrl  String?
  createdAt       DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([configId])
}

// ============ SAFETY INCIDENT WORKFLOWS ============
model SafetyIncidentWorkflow {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  detectionType   String   // VIOLENCE, WEAPON, FALL_MEDICAL, INTRUSION, SMOKE_FIRE, CROWD_DENSITY, ANY
  severity        String   // LOW, MEDIUM, HIGH, CRITICAL, ANY
  name            String   // human-readable workflow name
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps           SafetyWorkflowStep[]

  @@index([schoolId, detectionType, severity])
}

model SafetyWorkflowStep {
  id              String   @id @default(cuid())
  workflowId      String
  workflow        SafetyIncidentWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order           Int      // 1, 2, 3... execution order
  actionType      String   // NOTIFY_ROLE, NOTIFY_PARENTS, LOCKDOWN_ZONE, CALL_EMERGENCY, SOUND_SIREN, SEND_MESSAGE, ACTIVATE_PA, ESCALATE, WAIT
  config          String   // JSON: { roles: [...], message: '...', zoneId: '...', phoneNumber: '...', durationSec: 60 }
  delaySec        Int      @default(0) // delay before executing this step (after previous step completes)
  description     String   // human-readable
  createdAt       DateTime @default(now())

  @@index([workflowId, order])
}

// ============ GATE EXIT MONITORING (HIK-Connect integration) ============
// Detects students exiting through school gates during school hours
// (9:00 AM - 3:30 PM) via HIK-connect cameras + face recognition,
// and auto-notifies admins + parents via WhatsApp/SMS/Email.

model GateExitConfig {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  // School hours — any student exiting during this window is flagged
  schoolStart     String   @default("09:00") // HH:MM
  schoolEnd       String   @default("15:30") // HH:MM
  // Gate camera config — the HIK-connect cameras at entrance/exit gates
  entranceCameraId String?  // FK to SafetyCamera
  exitCameraId     String?  // FK to SafetyCamera
  // HIK-Connect credentials (encrypted)
  hikUsernameEnc  String?  // encrypted HIK-connect username
  hikPasswordEnc  String?  // encrypted HIK-connect password
  hikSiteId       String?  // HIK-connect site ID
  // Notification config
  notifyAdminRoles String   @default("[\"SUPER_ADMIN\",\"SCHOOL_HEAD\",\"ADMIN\",\"RECEPTION\"]") // JSON array
  notifyParentChannels String @default("[\"WHATSAPP\",\"SMS\",\"EMAIL\"]") // JSON array
  // Grace period — students exiting within X minutes of school end are not flagged
  gracePeriodMin  Int      @default(15)
  isActive        Boolean  @default(true)
  // Polling interval for the HIK-connect API (seconds)
  pollIntervalSec Int      @default(30)
  lastPollAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, isActive])
}

model GateExitAlert {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  // Student info (denormalized for fast retrieval)
  studentId       String?  // null if face not recognized (unknown person)
  studentName     String   // "Unknown Student" if not recognized
  studentGrade    String?  // e.g. "7-A"
  studentPhoto    String?  // emoji or photo URL
  // Detection details
  gate            String   // "ENTRANCE" or "EXIT"
  cameraId        String?
  cameraName      String?
  snapshotUrl     String?  // CCTV snapshot of the exit
  detectedAt      DateTime @default(now())
  // Face recognition
  faceConfidence  Float?   // 0..1
  faceMatchType   String   @default("ENROLLED") // ENROLLED, UNKNOWN, STAFF
  // Notification status
  adminNotifiedAt DateTime?
  parentNotifiedAt DateTime?
  parentWhatsAppStatus String?  // SENT, DELIVERED, READ, FAILED
  parentSmsStatus  String?
  parentEmailStatus String?
  // Alert status
  status          String   @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, RESOLVED, FALSE_ALARM
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  // Reason text (e.g. "Student exited via main gate during school hours (09:30 AM)")
  reason          String
  // Link to the SafetyAlert record (so it shows in the global popup)
  safetyAlertId   String?
  createdAt       DateTime @default(now())

  @@index([schoolId, status, detectedAt])
  @@index([studentId, detectedAt])
  @@index([detectedAt])
}

// ============ GATE MONITORING — Extended AI detections ============

// Pre-approved early exit permission — set by admin when a parent
// authorizes pickup (e.g. doctor's appointment). The gate system checks
// this BEFORE triggering an alert.
model EarlyExitPermission {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  studentId       String   // FK to Student
  studentName     String   // denormalized for fast lookup
  approvedBy      String   // userId of admin who approved
  approverName    String
  reason          String   // "Doctor appointment", "Family emergency", etc.
  validFrom       DateTime // earliest time the student can exit
  validUntil      DateTime // latest time the permission is valid
  guardianName    String?  // who is picking up (if applicable)
  guardianPhone   String?
  guardianRelation String? // "Mother", "Father", "Uncle"
  isUsed          Boolean  @default(false) // marked true when the student actually exits
  usedAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([schoolId, studentId, validUntil])
  @@index([validFrom, validUntil])
}

// Guardian verification — pre-approved guardians who can pick up a student.
// Face recognition at the gate matches against this table to verify
// that the person picking up is an approved guardian.
model ApprovedGuardian {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  studentId       String   // FK to Student
  studentName     String
  guardianName    String
  guardianPhone   String
  guardianEmail   String?
  guardianRelation String  // "Mother", "Father", "Uncle", "Aunt"
  faceEncRef      String?  // reference to enrolled face embedding
  photoUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([schoolId, studentId])
  @@index([guardianPhone])
}

// Late arrival detection — student arrives after school start time
model LateArrivalAlert {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  studentId       String?
  studentName     String
  studentGrade    String?
  gate            String   // "ENTRANCE"
  cameraName      String?
  snapshotUrl     String?
  arrivedAt       DateTime @default(now())
  minutesLate     Int      // minutes after school start
  parentNotifiedAt DateTime?
  parentWhatsAppStatus String?
  parentSmsStatus String?
  status          String   @default("ACTIVE") // ACTIVE, ACKNOWLEDGED
  reason          String
  createdAt       DateTime @default(now())

  @@index([schoolId, status, arrivedAt])
  @@index([studentId, arrivedAt])
}

// Loitering detection — student remains near a gate/exit for too long
model LoiteringAlert {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  studentId       String?
  studentName     String   // "Unknown Person" if not recognized
  location        String   // gate/zone name
  cameraId        String?
  cameraName      String?
  snapshotUrl     String?
  detectedAt      DateTime @default(now())
  durationSec     Int      // how long they were loitering
  thresholdSec    Int      // what the loitering threshold was
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  @@index([schoolId, status, detectedAt])
}

// ============ INTEGRATION CONFIG (WhatsApp, SMS, Payment, Push) ============
model IntegrationConfig {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  provider        String   // WHATSAPP, SMS, RAZORPAY, STRIPE, FCM_PUSH
  isActive        Boolean  @default(false)
  // Credentials (stored encrypted in production via safety/crypto.ts)
  apiKeyEnc       String?  // auth key / access token / API key
  apiSecretEnc    String?  // secret key / auth token
  phoneNumberId   String?  // WhatsApp phone number ID / Twilio from-number
  businessName    String?  // sender ID / business name
  webhookUrl      String?  // webhook URL for payment callbacks
  metadata        String?  // JSON for additional config
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, provider])
  @@index([schoolId, isActive])
}

// ============ PAYMENTS (Online Fee Payment Gateway) ============
model PaymentOrder {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  orderId         String   @unique // gateway order ID (e.g. razorpay order ID)
  paymentId       String?  // gateway payment ID (set after payment success)
  studentId       String?
  studentName     String
  grade           String?
  parentName      String
  parentPhone     String
  parentEmail     String?
  feeType         String   // Tuition Q4, Transport, Exam Fee, etc.
