// LearnX AI School ERP - Complete Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH & USERS ============
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  phone         String?
  avatar        String?
  role          String   @default("TEACHER") // SUPER_ADMIN, SCHOOL_HEAD, ADMIN, TEACHER, STUDENT, PARENT, RECEPTION, IT_TEAM
  isActive      Boolean  @default(true)
  lastLogin     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  students      Student[]
  staff         Staff?
  parents       Parent[]
  notifications Notification[]
  auditLogs     AuditLog[]
  chatSessions  ChatSession[]
  activities    UserActivity[]
}

// ============ SCHOOL & ACADEMIC ============
model School {
  id            String   @id @default(cuid())
  name          String
  address       String?
  city          String?
  state         String?
  phone         String?
  email         String?
  website       String?
  logo          String?
  established   Int?
  affiliation   String?
  totalStudents Int      @default(0)
  totalStaff    Int      @default(0)
  createdAt     DateTime @default(now())
}

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   // e.g. "2025-2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  classes   Class[]
  exams     Exam[]
  events    Event[]
  fees      Fee[]
}

model Grade {
  id        String   @id @default(cuid())
  name      String   // e.g. "Grade 1", "Kindergarten"
  level     String   // KG, PRIMARY, SECONDARY, SR_SECONDARY
  order     Int

  sections  Section[]
  subjects  Subject[]
}

model Section {
  id        String   @id @default(cuid())
  name      String   // A, B, C
  gradeId   String
  grade     Grade    @relation(fields: [gradeId], references: [id])
  capacity  Int      @default(40)

  classes   Class[]
  students  Student[]
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String
  gradeId   String?
  grade     Grade?   @relation(fields: [gradeId], references: [id])
  isCore    Boolean  @default(true)

  exams     Exam[]
  lessons   LessonPlan[]
  portions  Portion[]
  scores    ExamScore[]
}

model Class {
  id           String   @id @default(cuid())
  academicYearId String
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  sectionId    String
  section      Section  @relation(fields: [sectionId], references: [id])
  classTeacherId String?
  room          String?

  timetable    Timetable[]
  students     Student[]   @relation("ClassStudents")
  // substitutions Substitution[]
}

// ============ STUDENTS ============
model Student {
  id              String   @id @default(cuid())
  admissionNo     String   @unique
  firstName       String
  lastName        String
  fullName        String
  dob             DateTime
  gender          String   // MALE, FEMALE, OTHER
  bloodGroup      String?
  nationality     String   @default("Indian")
  religion        String?
  category        String?  // General, OBC, SC, ST
  aadhaarNo       String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  fatherName      String?
  motherName      String?
  guardianName    String?
  guardianPhone   String
  guardianEmail   String?
  guardianOccupation String?
  annualIncome    Float?
  photo           String?
  medicalConditions String?
  allergies       String?
  admissionDate   DateTime @default(now())
  previousSchool  String?
  transferCertificate String?
  birthCertificate String?
  status          String   @default("ACTIVE") // ACTIVE, GRADUATED, TRANSFERRED, INACTIVE
  academicYearId  String?

  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  sectionId       String?
  section         Section? @relation(fields: [sectionId], references: [id])
  classId         String?
  class           Class?   @relation("ClassStudents", fields: [classId], references: [id])

  attendance      Attendance[]
  examScores      ExamScore[]
  fees            Fee[]
  leaveRequests   LeaveRequest[] @relation("StudentLeaves")
  reportCards     ReportCard[]
  behaviors       BehaviorRecord[]
  healthRecords   HealthRecord[]
  transportAssignments TransportAssignment[]
  hostelAllocations HostelAllocation[]
  canteenOrders   CanteenOrder[]
  activities      ActivityRegistration[]
  documents       Document[]
  alumni          Alumni?
  parent          Parent?
  ptmMeetings     PTMMeeting[]   @relation("StudentPTM")
  careerSessions  CareerCounselling[]
  safetyAlerts    SafetyAlert[]  @relation("StudentSafetyAlerts")

  // Phase 1: Household link
  household       Household? @relation(fields: [householdId], references: [id])
  householdId     String?
}

model Parent {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id])
  relation    String   // FATHER, MOTHER, GUARDIAN
  occupation  String?
  income      Float?
  createdAt   DateTime @default(now())
}

// ============ STAFF / HRMS ============
model Staff {
  id              String   @id @default(cuid())
  employeeId      String   @unique
  firstName       String
  lastName        String
  fullName        String
  dob             DateTime
  gender          String
  bloodGroup      String?
  qualification   String?
  experience      Float?
  designation     String
  department      String   // Teaching, Non-Teaching, Admin
  subjectSpecialization String?
  joiningDate     DateTime @default(now())
  retirementDate  DateTime?
  phone           String
  email           String
  address         String?
  city            String?
  state           String?
  pincode         String?
  aadhaarNo       String?
  panNo           String?
  bankAccountNo   String?
  bankIfsc        String?
  bankName        String?
  photo           String?
  status          String   @default("ACTIVE") // ACTIVE, ON_LEAVE, RESIGNED, TERMINATED
  employmentType  String   @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])

  salaryRecords   SalaryRecord[]
  leaveRequests   LeaveRequest[] @relation("StaffLeaves")
  attendance      StaffAttendance[]
  substitutions   Substitution[]  @relation("SubstituteTeacher")
  timetable       Timetable[]     @relation("TeacherTimetable")
  lessonPlans     LessonPlan[]
  examDuties      Exam[]          @relation("ExamInvigilator")
  ptmMeetings     PTMMeeting[]    @relation("StaffPTM")
  documents       Document[]      @relation("StaffDocuments")
}

model SalaryRecord {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id])
  month       String   // e.g. "2026-06"
  basicSalary Float
  hra         Float
  da          Float
  conveyance  Float
  specialAllowance Float
  grossSalary Float
  pfDeduction Float
  taxDeduction Float
  otherDeduction Float
  netSalary   Float
  status      String   @default("PENDING") // PENDING, PAID, PROCESSING
  paidOn      DateTime?
  createdAt   DateTime @default(now())
}

// ============ ATTENDANCE ============
model Attendance {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  date        DateTime
  status      String   // PRESENT, ABSENT, LATE, HALF_DAY, EXCUSED
  checkIn     DateTime?
  checkOut    DateTime?
  method      String   @default("BIOMETRIC") // BIOMETRIC, RFID, FACE, MANUAL
  deviceId    String?
  remark      String?
  createdAt   DateTime @default(now())
}

model StaffAttendance {
  id          String   @id @default(cuid())
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id])
  date        DateTime
  status      String   // PRESENT, ABSENT, LATE, WFH, ON_LEAVE
  checkIn     DateTime?
  checkOut    DateTime?
  method      String   @default("BIOMETRIC")
  workHours   Float?
  remark      String?
  createdAt   DateTime @default(now())
}

model LeaveRequest {
  id          String   @id @default(cuid())
  studentId   String?
  student     Student? @relation("StudentLeaves", fields: [studentId], references: [id])
  staffId     String?
  staff       Staff?   @relation("StaffLeaves", fields: [staffId], references: [id])
  leaveType   String   // CASUAL, SICK, EARNED, MATERNITY, PATERNITY, STUDY, UNPAID
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  appliedBy   String
  approvedBy  String?
  approvedOn  DateTime?
  attachment   String?
  daysCount   Float
  createdAt   DateTime @default(now())
}

// ============ FEES & FINANCE ============
model Fee {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  academicYearId String?
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  feeType     String   // TUITION, TRANSPORT, HOSTEL, LAB, LIBRARY, EXAM, SPORTS, UNIFORM, BOOKS, LATE
  amount      Float
  discount    Float    @default(0)
  paidAmount  Float    @default(0)
  balance     Float
  dueDate     DateTime
  status      String   @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE
  paymentMode String?  // CASH, CARD, UPI, NETBANKING, CHEQUE
  transactionId String?
  paidOn      DateTime?
  receiptNo   String?
  remark      String?
  createdAt   DateTime @default(now())

  installments FeeInstallment[]
}

model FeeInstallment {
  id          String   @id @default(cuid())
  feeId       String
  fee         Fee      @relation(fields: [feeId], references: [id])
  installmentNo Int
  amount      Float
  dueDate     DateTime
  paidDate    DateTime?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   // INCOME, EXPENSE
  category    String
  description String
  amount      Float
  date        DateTime
  paymentMode String?
  referenceNo String?
  recordedBy  String?
  createdAt   DateTime @default(now())
}

// ============ EXAMS & ACADEMICS ============
model Exam {
  id          String   @id @default(cuid())
  name        String   // e.g. "First Unit Test", "Half Yearly", "Final"
  examType    String   // UNIT_TEST, MONTHLY, HALF_YEARLY, FINAL, QUIZ, MOCK
  academicYearId String?
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  startDate   DateTime
  endDate     DateTime
  status      String   @default("SCHEDULED") // SCHEDULED, ONGOING, COMPLETED, CANCELLED
  invigilatorId String?
  invigilator Staff?   @relation("ExamInvigilator", fields: [invigilatorId], references: [id])
  totalMarks  Int      @default(100)
  passingMarks Int     @default(35)
  createdAt   DateTime @default(now())

  scores      ExamScore[]
  subjects    Subject[]
  questionPapers QuestionPaper[]
  reportCards ReportCard[]
}

model ExamScore {
  id          String   @id @default(cuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  marksObtained Float
  totalMarks  Int
  grade       String?
  percentage  Float
  rank        Int?
  remark      String?
  createdAt   DateTime @default(now())
}

model ReportCard {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  academicYearId String?
  examId      String?
  exam        Exam?    @relation(fields: [examId], references: [id])
  term        String   // TERM1, TERM2, FINAL
  overallPercentage Float
  overallGrade String
  overallRank Int?
  attendancePercentage Float
  conduct     String?
  teacherRemark String?
  principalRemark String?
  generatedAt DateTime @default(now())
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, PRINTED
}

model LessonPlan {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id])
  title       String
  topic       String
  objectives  String
  methodology String
  resources   String?
  duration    Int      // minutes
  date        DateTime
  status      String   @default("PLANNED") // PLANNED, COMPLETED, IN_PROGRESS
  createdAt   DateTime @default(now())
}

model Portion {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  title       String
  description String?
  totalTopics Int
  completedTopics Int  @default(0)
  syllabus    String?
  createdAt   DateTime @default(now())
}

model Timetable {
  id          String   @id @default(cuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id])
  staffId     String?
  staff       Staff?   @relation("TeacherTimetable", fields: [staffId], references: [id])
  day         String   // MONDAY, TUESDAY, ...
  period      Int
  startTime   String
  endTime     String
  subjectName String?
  room        String?
  isBreak     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Substitution {
  id              String   @id @default(cuid())
  originalTeacherId String
  originalTeacher Staff    @relation("SubstituteTeacher", fields: [originalTeacherId], references: [id])
  substituteTeacherId String?
  classId         String
  date            DateTime
  period          Int
  subject         String
  reason          String
  status          String   @default("PENDING") // PENDING, ASSIGNED, COMPLETED, CANCELLED
  assignedBy      String?
  assignedAt      DateTime?
  createdAt       DateTime @default(now())
}

// ============ TRANSPORT ============
model Vehicle {
  id          String   @id @default(cuid())
  vehicleNo   String   @unique
  type        String   // BUS, VAN, CAR
  capacity    Int
  driverName  String
  driverPhone String
  driverLicense String?
  routeId     String?
  gpsDeviceId String?
  insuranceExpiry DateTime?
  pollutionExpiry DateTime?
  fitnessExpiry DateTime?
  status      String   @default("ACTIVE") // ACTIVE, MAINTENANCE, INACTIVE
  createdAt   DateTime @default(now())

  route       Route?   @relation(fields: [routeId], references: [id])
  assignments TransportAssignment[]
}

model Route {
  id          String   @id @default(cuid())
  name        String
  startPoint  String
  endPoint    String
  stops       String   // JSON of stops array
  distance    Float    // km
  estimatedTime Int    // minutes
  fee         Float
  createdAt   DateTime @default(now())

  vehicles    Vehicle[]
  assignments TransportAssignment[]
}

model TransportAssignment {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  routeId     String?
  route       Route?   @relation(fields: [routeId], references: [id])
  pickupPoint String?
  dropPoint   String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
}

// ============ HOSTEL ============
model Hostel {
  id          String   @id @default(cuid())
  name        String
  type        String   // BOYS, GIRLS, CO_ED
  capacity    Int
  wardenId    String?
  wardenName  String?
  wardenPhone String?
  address     String?
  createdAt   DateTime @default(now())

  rooms       HostelRoom[]
}

model HostelRoom {
  id          String   @id @default(cuid())
  hostelId    String
  hostel      Hostel   @relation(fields: [hostelId], references: [id])
  roomNo      String
  floor       Int
  capacity    Int
  occupied    Int      @default(0)
  type        String   // SINGLE, DOUBLE, DORMITORY
  fee         Float
  status      String   @default("AVAILABLE") // AVAILABLE, FULL, MAINTENANCE

  allocations HostelAllocation[]
}

model HostelAllocation {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  roomId      String
  room        HostelRoom @relation(fields: [roomId], references: [id])
  allocationDate DateTime @default(now())
  vacateDate  DateTime?
  status      String   @default("ACTIVE")
}

// ============ CANTEEN ============
model CanteenItem {
  id          String   @id @default(cuid())
  name        String
  category    String   // BREAKFAST, LUNCH, SNACKS, BEVERAGES
  price       Float
  isVeg       Boolean  @default(true)
  isAvailable Boolean  @default(true)
  description String?
  image       String?
  createdAt   DateTime @default(now())

  orders      CanteenOrder[]
}

model CanteenOrder {
  id          String   @id @default(cuid())
  orderId     String   @unique
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id])
  staffId     String?
  itemId      String
  item        CanteenItem @relation(fields: [itemId], references: [id])
  quantity    Int
  totalAmount Float
  status      String   @default("PENDING") // PENDING, PREPARING, READY, SERVED, CANCELLED
  orderDate   DateTime @default(now())
  paymentStatus String @default("PENDING")
}

// ============ LIBRARY / DOCUMENTS ============
model Document {
  id          String   @id @default(cuid())
  title       String
  type        String   // TC, BIRTH_CERT, MARKSHEET, BONAFIDE, ID_CARD, OTHER
  studentId   String?
  student     Student? @relation(fields: [studentId], references: [id])
  staffId     String?
  staff       Staff?   @relation("StaffDocuments", fields: [staffId], references: [id])
  fileUrl     String
  fileFormat  String
  fileSize    Int?
  uploadedBy  String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ============ EVENTS & ACTIVITIES ============
model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   // ACADEMIC, SPORTS, CULTURAL, HOLIDAY, EXAM, PTM, WORKSHOP
  startDate   DateTime
  endDate     DateTime?
  venue       String?
  academicYearId String?
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  organizer   String?
  status      String   @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())
}

model ExtracurricularActivity {
  id          String   @id @default(cuid())
  name        String
  category    String   // SPORTS, MUSIC, DANCE, ART, ROBOTICS, DEBATE, SCIENCE_CLUB
  description String?
  coachId     String?
  schedule    String?
  venue       String?
  fee         Float    @default(0)
  createdAt   DateTime @default(now())

  registrations ActivityRegistration[]
}

model ActivityRegistration {
  id          String   @id @default(cuid())
  activityId  String
  activity    ExtracurricularActivity @relation(fields: [activityId], references: [id])
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  status      String   @default("ENROLLED") // ENROLLED, COMPLETED, DROPPED
  performance String?
  rating      Int?
  registeredOn DateTime @default(now())
}

// also fix references


// ============ HEALTH & WELLNESS ============
model HealthRecord {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  height      Float?   // cm
  weight      Float?   // kg
  bmi         Float?
  bloodPressure String?
  vision      String?
  hearing     String?
  allergies   String?
  chronicConditions String?
  medications String?
  lastCheckup DateTime?
  nextCheckup DateTime?
  doctorName  String?
  notes       String?
  createdAt   DateTime @default(now())
}

// ============ BEHAVIOR & AI TRACKING ============
model BehaviorRecord {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  date        DateTime
  type        String   // POSITIVE, NEGATIVE, NEUTRAL
  category    String   // DISCIPLINE, ACADEMIC, SOCIAL, ATTENDANCE
  description String
  points      Int      @default(0) // positive or negative
  recordedBy  String?
  actionTaken String?
  createdAt   DateTime @default(now())
}

model UserActivity {
  id          String   @id @default(cuid())
  type        String   // LOGIN, CREATE, UPDATE, DELETE, VIEW, AI_QUERY
  module      String
  description String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  metadata    String?  // JSON
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// ============ PTM ============
model PTMMeeting {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation("StudentPTM", fields: [studentId], references: [id])
  staffId     String?
  staff       Staff?   @relation("StaffPTM", fields: [staffId], references: [id])
  date        DateTime
  duration    Int      @default(15)
  mode        String   @default("OFFLINE") // OFFLINE, ONLINE
  status      String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  agenda      String?
  feedback    String?
  parentRating Int?
  createdAt   DateTime @default(now())
}

// ============ ALUMNI ============
model Alumni {
  id          String   @id @default(cuid())
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id])
  passingYear Int
  currentStatus String? // STUDYING, WORKING, ENTREPRENEUR
  organization String?
  designation String?
  email       String?
  phone       String?
  linkedin    String?
  isMentor    Boolean  @default(false)
  joinedAt    DateTime @default(now())
}

// ============ CAREER COUNSELLING ============
model CareerCounselling {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  sessionDate DateTime
  counsellor  String?
  aptitudeScore Float?
  interestArea String?
  recommendedCareers String? // JSON array
  personalityType String?
  strength    String?
  weakness    String?
  aiRecommendation String?
  status      String   @default("SCHEDULED")
  createdAt   DateTime @default(now())
}

// ============ QUESTION PAPER (AI) ============
model QuestionPaper {
  id          String   @id @default(cuid())
  examId      String?
  exam        Exam?    @relation(fields: [examId], references: [id])
  subject     String
  grade       String
  totalMarks  Int
  duration    Int      // minutes
  difficulty  String   @default("MEDIUM") // EASY, MEDIUM, HARD, MIXED
  blueprint   String?  // JSON
  questions   String?  // JSON of generated questions
  aiGenerated Boolean  @default(true)
  reviewed    Boolean  @default(false)
  reviewedBy  String?
  createdAt   DateTime @default(now())
}

// ============ SAFETY ALERTS ============
model SafetyAlert {
  id          String   @id @default(cuid())
  type        String   // FIRE, FIGHT, FALL, INTRUSION, SMOKE, ABSENCE, UNAUTHORIZED
  severity    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  location    String
  description String
  cameraId    String?
  studentId   String?
  student     Student? @relation("StudentSafetyAlerts", fields: [studentId], references: [id])
  staffId     String?
  status      String   @default("ACTIVE") // ACTIVE, ACKNOWLEDGED, RESOLVED, FALSE_ALARM
  aiConfidence Float?
  triggeredAt DateTime @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  actionTaken String?
}

// ============ NOTIFICATIONS ============
model Notification {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  title       String
  message     String
  type        String   @default("INFO") // INFO, WARNING, ERROR, SUCCESS, ANNOUNCEMENT
  module      String?
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  isRead      Boolean  @default(false)
  actionUrl   String?
  metadata    String?
  createdAt   DateTime @default(now())
}

// ============ AUDIT LOG ============
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  module      String
  description String
  ipAddress   String?
  userAgent   String?
  metadata    String?
  createdAt   DateTime @default(now())
}

// ============ AI CHAT / RAG ============
model ChatSession {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  title       String?
  context     String?  // module context
  messages    String?  // JSON of messages
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeDocument {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String
  tags        String?
  embedding   String?
  metadata    String?
  createdAt   DateTime @default(now())
}

model MockTest {
  id          String   @id @default(cuid())
  studentId   String?
  subject     String
  topic       String?
  difficulty  String
  questions   String   // JSON
  duration    Int
  totalMarks  Int
  status      String   @default("AVAILABLE") // AVAILABLE, IN_PROGRESS, COMPLETED
  attemptId   String?
  score       Float?
  aiAnalysis  String?
  createdAt   DateTime @default(now())
}

// ============================================================
// PHASE 1 — CANONICAL ENTITY GRAPH & EVENT BACKBONE
// ============================================================

// ============ HOUSEHOLD (family unit for sibling logic, shared fee ledger) ============
model Household {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  familyName      String
  primaryAddress  String?
  primaryPhone    String?
  primaryEmail    String?
  annualIncome    Float?
  feeLedgerId     String?  // shared fee ledger reference
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         PersonRelationship[]
  students        Student[]
}

// ============ PERSON RELATIONSHIPS (guardian_of, sibling_of, emergency_contact_of, authorized_pickup_of) ============
model PersonRelationship {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  fromPersonType  String   // STUDENT, STAFF, GUARDIAN
  fromPersonId    String
  toPersonType    String   // STUDENT, STAFF, GUARDIAN
  toPersonId      String
  relationType    String   // guardian_of, sibling_of, emergency_contact_of, authorized_pickup_of, parent_of
  isPrimary       Boolean  @default(false)
  metadata        String?  // JSON: custody %, pickup auth, etc.
  createdAt       DateTime @default(now())

  household       Household? @relation(fields: [householdId], references: [id])
  householdId     String?
}

// ============ POLICY (school rules as versioned data) ============
model Policy {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  name            String   // e.g., "grading_bands", "fine_rules", "numbering_scheme"
  category        String   // ACADEMIC, FINANCIAL, OPERATIONAL, SAFETY
  version         Int      @default(1)
  data            String   // JSON: the actual policy rules
  isActive        Boolean  @default(true)
  effectiveFrom   DateTime @default(now())
  effectiveTo     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============ EVENT LOG (the bloodstream — §1.2) ============
model EventLog {
  id              String   @id @default(cuid())
  ulid            String   @unique // ULID for ordering
  schoolId        String   @default("school_default")
  type            String   // e.g., student.admitted, attendance.marked, fee.paid
  entityType      String   // STUDENT, STAFF, FEE, etc.
  entityId        String
  payload         String   // JSON: event-specific data
  actorType       String   // human, ai, system
  actorId         String?
  causationId     String?  // links to parent event (why did this happen)
  correlationId   String?  // links related events in same workflow
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([schoolId, type])
  @@index([entityType, entityId])
  @@index([causationId])
  @@index([correlationId])
}

// ============ EVENT CONSUMER LEDGER (idempotency) ============
model EventConsumerLedger {
  id              String   @id @default(cuid())
  eventLogId      String
  consumerName    String   // e.g., "notification-service", "rag-indexer"
  processedAt     DateTime @default(now())
  result          String   // SUCCESS, FAILED, DLQ
  error           String?

  @@unique([eventLogId, consumerName])
  @@index([consumerName, result])
}

// ============ EVENT OUTBOX (transactional outbox pattern) ============
model EventOutbox {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  type            String
  entityType      String
  entityId        String
  payload         String   // JSON
  actorType       String
  actorId         String?
  causationId     String?
  correlationId   String?
  status          String   @default("PENDING") // PENDING, PUBLISHED, FAILED
  attempts        Int      @default(0)
  lastAttemptAt   DateTime?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([status, createdAt])
}

// ============ TASK (system-generated, SLA-tracked) ============
model Task {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  title           String
  description     String?
  assigneeRole    String   // TEACHER, ADMIN, PRINCIPAL, etc.
  assigneeId      String?
  entityType      String   // STUDENT, FEE, etc.
  entityId        String?
  priority        String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status          String   @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, ESCALATED, CANCELLED
  slaDeadline     DateTime?
  workflowInstanceId String?
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  completedAt     DateTime?

  @@index([assigneeRole, status])
  @@index([entityType, entityId])
}

// ============ COMMUNICATION LOG (channel, language, delivery/read tracking) ============
model CommunicationLog {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  channel         String   // SMS, WHATSAPP, EMAIL, PUSH, IN_APP
  recipientType   String   // STUDENT, PARENT, STAFF
  recipientId     String
  recipientContact String  // phone or email
  templateName    String?
  subject         String?
  body            String
  language        String   @default("en")
  status          String   @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  errorMessage    String?
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  @@index([recipientType, recipientId])
  @@index([status])
}

// ============ DEDUPE CANDIDATE (fuzzy-match duplicate detection) ============
model DedupeCandidate {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  personType      String   // STUDENT, STAFF
  personId1       String
  personId2       String
  similarityScore Float    // 0.0 to 1.0
  matchFields     String   // JSON: which fields matched
  status          String   @default("PENDING") // PENDING, MERGED, REJECTED
  mergedIntoId    String?  // which record was kept
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?
  resolvedBy      String?

  @@index([status])
}

// ============ PROFILE COMPLETENESS (per-entity computed) ============
model ProfileCompleteness {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  entityType      String   // STUDENT, STAFF
  entityId        String
  completenessPct Float    @default(0)
  missingFields   String   // JSON array of field names
  staleFields     String   // JSON array of field names needing refresh
  lastComputedAt  DateTime @default(now())

  @@unique([entityType, entityId])
}

// ============ AT-RISK SCORE (versioned, explainable) ============
model AtRiskScore {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  studentId       String
  score           Float    // 0-100, higher = more at risk
  factors         String   // JSON: { attendance: 0.3, grades: 0.4, incidents: 0.2, engagement: 0.1 }
  version         Int      @default(1)
  computedAt      DateTime @default(now())

  @@index([studentId, computedAt])
}

// ============ FEATURE FLAG (per-school capability toggles) ============
model FeatureFlag {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  flagKey         String   // e.g., "ai_extraction", "simulation_mode", "auto_payroll"
  enabled         Boolean  @default(false)
  config          String?  // JSON: flag-specific configuration
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, flagKey])
}

// ============ AI ACTION PLAN (two-phase protocol: prepare → confirm) ============
model AiActionPlan {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  planId          String   @unique // external ID for API
  agentType       String   // IntakeAgent, OpsAgent, FinanceAgent, etc.
  actionType      String   // e.g., "bulk_reminder", "substitution_plan"
  summary         String   // human-readable summary
  diffs           String   // JSON: exact record diffs
  affectedCount   Int      // number of people/records affected
  tier            String   // A, B, C
  status          String   @default("PREPARED") // PREPARED, CONFIRMED, REJECTED, EXPIRED, EXECUTED
  contextHash     String   // hash of context at prepare time (for staleness check)
  requestedBy     String   // user ID
  approvedBy      String?
  expiresAt       DateTime // 15 min from prepare
  executedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([status, expiresAt])
  @@index([requestedBy])
}

// ============ AGENT INVOCATION (cost observability) ============
model AgentInvocation {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  agentType       String   // IntakeAgent, OpsAgent, etc.
  modelUsed       String   // e.g., "glm-4", "glm-4.6v"
  purpose         String   // e.g., "extract_admission_form", "draft_reminder"
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  latencyMs       Int      @default(0)
  costUsd         Float    @default(0)
  success         Boolean  @default(true)
  errorMessage    String?
  actionPlanId    String?
  createdAt       DateTime @default(now())

  @@index([agentType, createdAt])
}

// ============ INSIGHT CARD (role-specific insight feed) ============
model InsightCard {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  targetRole      String   // PRINCIPAL, ADMIN, TEACHER, etc.
  targetType      String   // INDIVIDUAL, CLASS, SCHOOL
  targetId        String?  // specific entity if INDIVIDUAL
  category        String   // ATTENDANCE, ACADEMIC, FINANCIAL, SAFETY, ENGAGEMENT
  severity        String   @default("INFO") // INFO, WARNING, CRITICAL, POSITIVE
  title           String
  body            String
  actionLabel     String?
  actionUrl       String?
  metadata        String?  // JSON
  isRead          Boolean  @default(false)
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([targetRole, isRead])
}

// ============ WORKFLOW DEFINITION (versioned JSON DSL for sagas) ============
model WorkflowDefinition {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  name            String   // e.g., "admission_cascade", "exit_cascade"
  version         Int      @default(1)
  steps           String   // JSON: step definitions
  compensations   String   // JSON: compensating actions per step
  humanGates      String   // JSON: which steps need human approval
  timeouts        String   // JSON: per-step timeout config
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  instances       WorkflowInstance[]
}
model WorkflowInstance {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  definitionId    String
  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id])
  definitionVersion Int
  status          String   @default("PENDING") // PENDING, RUNNING, PAUSED, COMPLETED, FAILED, COMPENSATING
  stepCursor      Int      @default(0)
  context         String   // JSON: saga context data
  triggerEventId  String?  // event that started this saga
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  errorMessage    String?

  stepLogs        WorkflowStepLog[]

  @@index([status])
}

// ============ WORKFLOW STEP LOG (per-step execution — resumable) ============
model WorkflowStepLog {
  id              String   @id @default(cuid())
  instanceId      String
  instance        WorkflowInstance @relation(fields: [instanceId], references: [id])
  stepIndex       Int
  stepName        String
  status          String   // PENDING, RUNNING, COMPLETED, FAILED, SKIPPED, COMPENSATED
  startedAt       DateTime?
  completedAt     DateTime?
  result          String?  // JSON
  errorMessage    String?

  @@index([instanceId, stepIndex])
}

// ============ AUTOMATION RULE (trigger → conditions → actions) ============
model AutomationRule {
  id              String   @id @default(cuid())
  schoolId        String   @default("school_default")
  name            String
  description     String?
  triggerEvent    String   // event type that triggers this rule
  conditions      String   // JSON: AST conditions
  actions         String   // JSON: array of actions
  tier            String   @default("A") // A (auto), B (one-click), C (senior approval)
  simulationMode  Boolean  @default(false)
  enabled         Boolean  @default(true)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs            RuleRun[]

  @@index([schoolId, triggerEvent, enabled])
}

// ============ RULE RUN (every rule execution logged) ============
model RuleRun {
  id              String   @id @default(cuid())
  ruleId          String
  rule            AutomationRule @relation(fields: [ruleId], references: [id])
  triggerEventId  String
  matched         Boolean  @default(false)
  intendedActions String   // JSON: what WOULD be done (for simulation mode)
  executedActions String   // JSON: what WAS done
  simulationMode  Boolean  @default(false)
  success         Boolean  @default(true)
  errorMessage    String?
  executedAt      DateTime @default(now())

  @@index([ruleId, executedAt])
}
